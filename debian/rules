#!/usr/bin/make -f

%:
	dh $@ --buildsystem=pybuild


override_dh_installsystemd:
	dh_installsystemd --name=wb-mqtt-dali


# The simulator is a development tool: it builds and is tested, but is not
# installed. Finding nothing to remove fails the build, so it cannot
# silently come back.
override_dh_auto_install:
	dh_auto_install
	set -e; \
	sim=$$(find debian/wb-mqtt-dali -type d -path '*/wb/mqtt_dali/sim'); \
	test -n "$$sim" || { echo "wb/mqtt_dali/sim not found in the installed tree" >&2; exit 1; }; \
	rm -r $$sim
