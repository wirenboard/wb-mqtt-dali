{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",

  "properties": {
    "name": {
      "type": "string",
      "title": "Device name",
      "minLength": 1,
      "propertyOrder": 0,
      "options": {
        "grid_columns": 6
      }
    },
    "mqtt_id": {
      "type": "string",
      "title": "MQTT id of the device",
      "description": "Used as part of the topic",
      "pattern": "^[^$#+\\/\"']+$",
      "propertyOrder": 1,
      "minLength": 1,
      "options": {
        "patternmessage": "Invalid device ID",
        "grid_columns": 6
      }
    },
    "brand_name": {
      "type": "string",
      "title": "Brand Name",
      "propertyOrder": 3,
      "options": {
        "grid_columns": 6,
        "wb": {
          "read_only": true
        }
      }
    },
    "product_name": {
      "type": "string",
      "title": "Product Name",
      "propertyOrder": 4,
      "options": {
        "grid_columns": 6,
        "wb": {
          "read_only": true
        }
      }
    },
    "short_address": {
      "type": "number",
      "title": "Short Address",
      "propertyOrder": 14,
      "minimum": 0,
      "maximum": 63,
      "default": 0,
      "options": {
        "grid_columns": 6,
        "wb": {
          "new_row": true
        }
      }
    },
    "random_address": {
      "type": "string",
      "title": "Random Address",
      "propertyOrder": 15,
      "options": {
        "grid_columns": 6,
        "wb": {
          "read_only": true
        }
      }
    }
  },

  "required": ["short_address", "mqtt_id", "name"],

  "translations": {
    "ru": {
      "Groups": "Группы",
      "Short Address": "Короткий адрес",
      "Random Address": "Случайный адрес",
      "Device name": "Название устройства",
      "MQTT id of the device": "Идентификатор устройства в MQTT",
      "Used as part of the topic": "Используется как часть топика в MQTT",
      "Brand Name": "Производитель",
      "Product Name": "Модель"
    }
  }
}
